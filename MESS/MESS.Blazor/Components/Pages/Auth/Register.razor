@page "/Register"
@using MESS.Data.Models
@using MESS.Services.CRUD.ApplicationUser
@using Microsoft.AspNetCore.Identity
@using Serilog
@inject IApplicationUserService ApplicationUserService
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<div class="login-page-root">
    <div class="d-flex justify-content-center align-items-center w-100">
    <div class="card shadow" style="min-width: 350px; max-width: 450px;">
        <div class="card-header bg-black text-white">
            <h3 class="m-0">Register</h3>
        </div>
        <div class="card-body p-4">
            <form @onsubmit="HandleRegistrationAsync">
                <div class="form-group mb-3">
                    <label class="form-label">Username</label>
                    <InputText @bind-Value="Username" class="form-control" placeholder="Enter your username..." required/>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">First Name</label>
                    <InputText @bind-Value="FirstName" class="form-control" placeholder="Enter your first name..." required/>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Last Name</label>
                    <InputText @bind-Value="LastName" class="form-control" placeholder="Enter your last name..." required/>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Email (optional)</label>
                    <InputText @bind-Value="Email" class="form-control" placeholder="Enter your email..."/>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" placeholder="Enter your password..." @bind="Password" @bind:event="oninput" required/>
                    <div class="form-text">Min 8 characters with upper, lower, and digit.</div>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Confirm password</label>
                    <input type="password" class="form-control" placeholder="Repeat password" @bind="ConfirmPassword" @bind:event="oninput" required/>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Register</button>
                </div>

                <div class="text-center mt-3">
                    <a href="/auth/Login">Back to login</a>
                </div>
            </form>
            
            @if (ErrorMessages?.Count > 0)
            {
                <div class="mt-3">
                    @foreach (var error in ErrorMessages)
                    {
                        <p class="text-danger m-0 small">@error.Description</p>
                    }
                </div>
            }
        </div>
    </div>
    </div>
</div>

@code {
    private string Username { get; set; } = "";
    private string FirstName { get; set; } = "";
    private string LastName { get; set; } = "";
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private List<IdentityError> ErrorMessages { get; set; } = new List<IdentityError>();
    
    
    private async Task HandleRegistrationAsync()
    {
        ErrorMessages.Clear();

        if (string.IsNullOrWhiteSpace(Username))
        {
            ErrorMessages.Add(new IdentityError { Description = "Username is required." });
        }

        if (string.IsNullOrWhiteSpace(FirstName))
        {
            ErrorMessages.Add(new IdentityError { Description = "First name is required." });
        }

        if (string.IsNullOrWhiteSpace(LastName))
        {
            ErrorMessages.Add(new IdentityError { Description = "Last name is required." });
        }

        if (string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessages.Add(new IdentityError { Description = "Password is required." });
        }
        else if (Password != ConfirmPassword)
        {
            ErrorMessages.Add(new IdentityError { Description = "Password and confirmation do not match." });
        }

        if (ErrorMessages.Count > 0)
        {
            return;
        }

        var user = new ApplicationUser
        {
            UserName = Username,
            Email = string.IsNullOrWhiteSpace(Email) ? null : Email,
            FirstName = FirstName,
            LastName = LastName
        };

        var result = await ApplicationUserService.AddApplicationUser(user, Password);

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/auth/Login?registered=1");
        }
        else
        {
            Log.Warning("Unable to register new user with email: {Email}. Failed with the following errors: {errors}", 
                Email, result.Errors);
            ErrorMessages.AddRange(result.Errors);
        }
    }
}
