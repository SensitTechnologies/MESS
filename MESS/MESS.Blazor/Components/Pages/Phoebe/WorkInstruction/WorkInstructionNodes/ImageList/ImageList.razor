@using MESS.Blazor.Components.Pages.Phoebe.WorkInstruction.WorkInstructionNodes.SortableList
@using MESS.Services.Media.WorkInstructions
@using MESS.Data.Models

@inject IWorkInstructionImageService WorkInstructionImageService

<div class="card shadow-sm">
    <div class="card-header">
        <strong>@ActiveLabel Images</strong>
    </div>
    
    <div class="card-body">
        @if (ActiveImages.Count == 0)
        {
            <p>No images in @ActiveLabel. Add some below.</p>
        }
        else
        {
            @* Drag only from the grip so clicking/selecting text in the caption box never starts a drag. *@
            <SortableList T="StepMediaItem"
                          Items="@(ActiveImages)"
                          OnUpdate="@SortList"
                          Handle=".image-drag-handle"
                          Context="image"
            >

                <SortableItemTemplate>
                    <div class="d-flex align-items-start justify-content-between border rounded my-2 shadow-sm">
                        <div class="d-flex flex-grow-1 align-items-center">
                            <i class="bi bi-grip-vertical h3 image-drag-handle" style="cursor: grab;" />
                            <div class="vr me-1" />
                            <img class="m-1" src="@image.Path" style="@ImageStyle" alt="@(image.Caption ?? "Step image")" />
                            <input type="text"
                                   class="form-control form-control-sm ms-2 me-1 image-caption-input"
                                   placeholder="Caption (optional)"
                                   aria-label="Image caption"
                                   maxlength="@StepMediaItem.CaptionMaxLength"
                                   value="@image.Caption"
                                   @oninput="e => HandleCaptionChanged(image, e.Value?.ToString())" />
                        </div>

                        <button class="btn btn-sm btn-primary m-1" title="Remove image" @onclick="() => HandleRemove(image)">
                            <i class="bi bi-trash" />
                        </button>
                    </div>
                </SortableItemTemplate>
            </SortableList>
            
        }
    </div>
    
    <div class="card-footer">
        <div class="upload-area my-1">
            <!-- Hidden file input -->
            <InputFile id="@_fileUploadId"
                       OnChange="HandleUpload"
                       multiple
                       accept="image/*"
                       class="d-none" />

            <label for="@_fileUploadId" class="btn btn-sm btn-primary">
                <i class="bi bi-upload"></i> Upload New @ActiveLabel Image(s)
            </label>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Gets or sets the list of primary media images (path + caption) (used when the component is in "Name" view).
    /// These images are shown and edited when <see cref="ShowBody"/> is <c>false</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public required List<StepMediaItem> PrimaryMedia { get; set; }

    /// <summary>
    /// Gets or sets the list of secondary media images (path + caption) (used when the component is in "Body" view).
    /// These images are shown and edited when <see cref="ShowBody"/> is <c>true</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public required List<StepMediaItem> SecondaryMedia { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the component is currently in "Body" view mode.
    /// When <c>true</c>, the component manages <see cref="SecondaryMedia"/>; when <c>false</c>, it manages <see cref="PrimaryMedia"/>.
    /// </summary>
    [Parameter]
    public required bool ShowBody { get; set; }

    /// <summary>
    /// Callback invoked when either the primary or secondary media list changes.
    /// The updated primary and secondary lists are provided as the callback argument.
    /// </summary>
    [Parameter]
    public EventCallback<(List<StepMediaItem> Primary, List<StepMediaItem> Secondary)> OnMediaChanged { get; set; }

    private List<StepMediaItem> ActiveImages =>
        ShowBody ? SecondaryMedia : PrimaryMedia;


    private string ActiveLabel => ShowBody ? "Secondary" : "Primary";
    
    private readonly string _fileUploadId = $"fileUpload_{Guid.NewGuid():N}";

    /// <summary>
    /// Gets or sets the inline style applied to the image.
    /// </summary>
    [Parameter]
    public string ImageStyle { get; set; } = "height: 80px; object-fit: cover;";

    private async Task SortList((int oldIndex, int newIndex) indices)
    {
        // deconstruct the tuple
        var (oldIndex, newIndex) = indices;
        if (oldIndex == newIndex) return;

        var itemToMove = ActiveImages[oldIndex];
        ActiveImages.RemoveAt(oldIndex);

        if (newIndex < ActiveImages.Count)
        {
            ActiveImages.Insert(newIndex, itemToMove);
        }
        else
        {
            ActiveImages.Add(itemToMove);
        }

        await NotifyChange();
    }

    // Stores the raw text (trimming happens on save) so typing a space between words isn't swallowed on re-render.
    private async Task HandleCaptionChanged(StepMediaItem image, string? value)
    {
        image.Caption = string.IsNullOrWhiteSpace(value) ? null : value;
        await NotifyChange();
    }

    private async Task HandleRemove(StepMediaItem image)
    {

        List<StepMediaItem> updatedList;

        if (ShowBody)
        {
            updatedList = new List<StepMediaItem>(SecondaryMedia);
        }
        else
        {
            updatedList = new List<StepMediaItem>(PrimaryMedia);
        }

        var index = updatedList.IndexOf(image);
        if (index == -1) return;

        await WorkInstructionImageService.DeleteImageFile(image.Path);
        updatedList.Remove(image);

        if (ShowBody)
        {
            SecondaryMedia = updatedList;
        }
        else
        {
            PrimaryMedia = updatedList;
        }

        await NotifyChange();
    }

    private async Task HandleUpload(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            var newPath = await WorkInstructionImageService.SaveImageFileAsync(file);

            List<StepMediaItem> updatedList;

            if (ShowBody)
            {
                updatedList = new List<StepMediaItem>(SecondaryMedia);
            }
            else
            {
                updatedList = new List<StepMediaItem>(PrimaryMedia);
            }

            updatedList.Add(new StepMediaItem { Path = newPath });


            if (ShowBody)
            {
                SecondaryMedia = updatedList;
            }
            else
            {
                PrimaryMedia = updatedList;
            }
        }

        await NotifyChange();
    }

    private async Task NotifyChange()
    {
        if (OnMediaChanged.HasDelegate)
        {
            await OnMediaChanged.InvokeAsync((PrimaryMedia, SecondaryMedia));
        }
        StateHasChanged();
    }
}
